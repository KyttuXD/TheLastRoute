+    pub fn set_frame_pacer(enabled: bool) {
+        #[cfg(target_os = "macos")]
+        crate::native::macos::FRAME_PACER_ENABLED.store(enabled, std::sync::atomic::Ordering::Relaxed);
+        #[cfg(not(target_os = "macos"))]
+        let _ = enabled;
+    }
