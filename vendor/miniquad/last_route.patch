+/// Seconds on the clock the command buffer's GPU timestamps use (mach absolute time).
+fn now_seconds() -> f64 {
+    extern "C" {
+        fn clock_gettime_nsec_np(clock_id: u32) -> u64;
+    }
+    // CLOCK_UPTIME_RAW
+    unsafe { clock_gettime_nsec_np(8) as f64 * 1e-9 }
