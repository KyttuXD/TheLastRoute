# Text files are LF in the repo and in every checkout (the Windows CI checkout used to turn them
# into CRLF and broke tests that match multi-line JSON text). Binary assets are never touched.
* text=auto eol=lf
*.rs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ico binary
*.icns binary
*.bbmodel text eol=lf
*.glb binary
*.gltf text eol=lf
