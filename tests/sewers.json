{
  "suite": "sewers",
  "description": "The sewer levels (-1 and -2) stay on their own storey while the runner moves through them.",
  "ported_from": "world/levels.rs, game/endless.rs (level_allowed, change_storey), headless agent runs",
  "defaults": { "seed": "BRAVO", "difficulty": "standard", "mode": "infinite", "god": true, "no_target": true },
  "tests": [
    {
      "name": "level -1 stays the upper sewer while walking",
      "start_run": { "level": -1, "god": true, "no_target": true },
      "steps": [
        { "cmd": "step", "frames": 90, "act": { "move": [0, 1] }, "observe": false },
        { "expect": [ { "path": "run.level", "value": -1 }, { "path": "run.depth", "value": 2 }, { "path": "run.active", "value": true } ] }
      ]
    },
    {
      "name": "level -2 stays the lower sewer while walking",
      "start_run": { "level": -2, "god": true, "no_target": true },
      "steps": [
        { "cmd": "step", "frames": 90, "act": { "move": [0, 1] }, "observe": false },
        { "expect": [ { "path": "run.level", "value": -2 }, { "path": "run.depth", "value": 3 }, { "path": "run.active", "value": true } ] }
      ]
    }
  ]
}