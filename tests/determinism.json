{
  "suite": "determinism",
  "description": "Same seed + same inputs = same state hash (fixed 60 Hz step), for scripted input, the bot and the Infinite route; a different seed differs.",
  "ported_from": "docs/PLAYTEST.md determinism (--fixed-fps 60, PlaytestObserver.state_hash, tools/build/playtest_check.sh)",
  "defaults": { "seed": 4242, "difficulty": "standard", "mode": "finite" },
  "tests": [
    {
      "name": "scripted input replays exactly",
      "steps": [
        { "cmd": "step", "frames": 120, "act": { "move": [0.3, 1], "look": [0.4, 0] }, "observe": false },
        { "cmd": "step", "frames": 240, "act": { "move": [-1, 0.5], "look": [-0.2, 0.1], "hold": { "sprint": true } }, "observe": false },
        { "cmd": "hash", "save_as": "a" },
        { "cmd": "start_run", "seed": 4242, "difficulty": "standard", "mode": "finite" },
        { "cmd": "step", "frames": 120, "act": { "move": [0.3, 1], "look": [0.4, 0] }, "observe": false },
        { "cmd": "step", "frames": 240, "act": { "move": [-1, 0.5], "look": [-0.2, 0.1], "hold": { "sprint": true } }, "observe": false },
        { "cmd": "hash", "expect": [ { "path": "last.hash", "var": "a.hash" }, { "path": "last.frame", "op": ">=", "value": 360 } ] },
        { "cmd": "start_run", "seed": 4243, "difficulty": "standard", "mode": "finite" },
        { "cmd": "step", "frames": 120, "act": { "move": [0.3, 1], "look": [0.4, 0] }, "observe": false },
        { "cmd": "step", "frames": 240, "act": { "move": [-1, 0.5], "look": [-0.2, 0.1], "hold": { "sprint": true } }, "observe": false },
        { "cmd": "hash", "expect": [ { "path": "last.hash", "op": "!=", "var": "a.hash" } ] }
      ]
    },
    {
      "name": "the bot replays exactly (finite, hunters awake)",
      "steps": [
        { "cmd": "bot", "frames": 1800, "observe": false },
        { "cmd": "hash", "save_as": "a" },
        { "cmd": "report", "save_as": "ra" },
        { "cmd": "start_run", "seed": 4242, "difficulty": "standard", "mode": "finite" },
        { "cmd": "bot", "frames": 1800, "observe": false },
        { "cmd": "hash", "expect": [ { "path": "last.hash", "var": "a.hash" } ] },
        { "cmd": "report", "expect": [ { "path": "last.report.score", "var": "ra.report.score" }, { "path": "last.report.walked", "var": "ra.report.walked" } ] }
      ]
    },
    {
      "name": "the Infinite route replays exactly",
      "start_run": { "mode": "infinite", "seed": 20261101 },
      "steps": [
        { "cmd": "bot", "frames": 2400, "observe": false },
        { "cmd": "hash", "save_as": "a" },
        { "cmd": "start_run", "seed": 20261101, "difficulty": "standard", "mode": "infinite" },
        { "cmd": "bot", "frames": 2400, "observe": false },
        { "cmd": "hash", "expect": [ { "path": "last.hash", "var": "a.hash" } ] }
      ]
    },
    {
      "name": "the host sim replays exactly with a resident floor",
      "start_run": { "mode": "infinite", "seed": 20261104, "level": -1 },
      "steps": [
        { "cmd": "bot", "frames": 1800, "observe": false },
        { "cmd": "hash", "save_as": "a" },
        { "cmd": "start_run", "seed": 20261104, "difficulty": "standard", "mode": "infinite", "level": -1 },
        { "cmd": "bot", "frames": 1800, "observe": false },
        { "cmd": "hash", "expect": [ { "path": "last.hash", "var": "a.hash" } ] },
        { "cmd": "start_run", "seed": 20261105, "difficulty": "standard", "mode": "infinite", "level": -1 },
        { "cmd": "bot", "frames": 1800, "observe": false },
        { "cmd": "hash", "expect": [ { "path": "last.hash", "op": "!=", "var": "a.hash" } ] }
      ]
    },
    {
      "name": "a flight chase replays exactly",
      "start_run": { "mode": "infinite", "seed": 20261104 },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "cmd": "step", "frames": 600, "act": { "move": [0, 0] }, "observe": false },
        { "cmd": "hash", "save_as": "a" },
        { "cmd": "start_run", "seed": 20261104, "difficulty": "standard", "mode": "infinite" },
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "cmd": "step", "frames": 600, "act": { "move": [0, 0] }, "observe": false },
        { "cmd": "hash", "expect": [ { "path": "last.hash", "var": "a.hash" } ] }
      ]
    }
  ]
}
