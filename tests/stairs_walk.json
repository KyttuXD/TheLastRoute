{
  "suite": "stairs_walk",
  "description": "Walking a stair flight (world/flight.rs, the body is steered along the flight's own walk path by headless/steer.rs, since a straight walk no longer follows a switchback or spiral): walking down the nearest flight reaches the storey below on the frame the body crosses the midpoint, with no fade, no hold and no lockout. Walking up from there returns to the storey above. The level changes only through the shared hysteresis (level_from_height). Standing still on the landing does not change the level.",
  "ported_from": "game/player/player_controller_3d.gd floor snap and stairs; world/vertical.rs stair_surface_y, level_from_height",
  "defaults": { "seed": 12345, "difficulty": "standard", "mode": "infinite" },
  "tests": [
    {
      "name": "standing on the landing of a flight down keeps the storey",
      "start_run": { "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "walk", "frames": 30, "fwd": 0, "observe": false },
        { "expect": [ { "path": "run.level", "value": 0 }, { "path": "run.depth", "value": 1 } ] }
      ]
    },
    {
      "name": "walking forward down a flight reaches level -1 at depth 2",
      "start_run": { "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "expect": [ { "path": "run.level", "value": -1 }, { "path": "run.depth", "value": 2 }, { "path": "player.y", "op": "approx", "value": -5, "tol": 0.1 }, { "path": "player.climbing", "value": false } ] }
      ]
    },
    {
      "name": "the storey changes on the frame the walk crosses the midpoint, and the walk goes on",
      "start_run": { "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "walk_flight", "dir": "down", "frames": 900, "stop_on_level_change": true },
        { "expect": [ { "path": "run.level", "value": -1 } ] },
        { "cmd": "step", "frames": 1, "act": { "move": [0, 1] }, "observe": false },
        { "expect": [ { "path": "run.level", "value": -1 } ] }
      ]
    },
    {
      "name": "an admin level jump rebuilds, a walk does not",
      "start_run": { "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "walk_flight", "dir": "down", "frames": 900, "stop_on_level_change": true },
        { "expect": [ { "path": "run.level", "value": -1 }, { "path": "run.depth", "value": 2 } ] }
      ]
    },
    {
      "name": "walking forward up from level -1 returns to level 0",
      "start_run": { "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "expect": [ { "path": "run.level", "value": -1 } ] },
        { "cmd": "teleport", "to": "stairs_up" },
        { "cmd": "walk_flight", "dir": "up", "frames": 900 },
        { "expect": [ { "path": "run.level", "value": 0 }, { "path": "player.y", "op": "approx", "value": 0, "tol": 0.1 } ] }
      ]
    },
    {
      "name": "a level-0 spiral (seed 129, doorway on the south wall) walks down and its foot leads out to the sewer tunnel",
      "start_run": { "seed": 129, "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "stairs_report", "expect": [ { "path": "last.stairs_report.flights.0.shape", "value": "spiral" } ] },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "expect": [ { "path": "run.level", "value": -1 }, { "path": "player.y", "op": "approx", "value": -5, "tol": 0.1 } ] },
        { "cmd": "goto", "x": 83.5, "z": 76.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] },
        { "cmd": "goto", "x": 83.5, "z": 70.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] }
      ]
    },
    {
      "name": "a level-0 spiral (seed 130, doorway on the south wall) leads out of its foot",
      "start_run": { "seed": 130, "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "stairs_report", "expect": [ { "path": "last.stairs_report.flights.0.shape", "value": "spiral" } ] },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "expect": [ { "path": "run.level", "value": -1 } ] },
        { "cmd": "goto", "x": 51.5, "z": 76.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] },
        { "cmd": "goto", "x": 51.5, "z": 70.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] }
      ]
    },
    {
      "name": "a level-0 spiral (seed 128, doorway on the north wall) leads out of its foot",
      "start_run": { "seed": 128, "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "stairs_report", "expect": [ { "path": "last.stairs_report.flights.0.shape", "value": "spiral" } ] },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "expect": [ { "path": "run.level", "value": -1 } ] },
        { "cmd": "goto", "x": 85.5, "z": 58.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] },
        { "cmd": "goto", "x": 85.5, "z": 64.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] }
      ]
    },
    {
      "name": "a level-0 switchback (seed 102) leads out of its foot",
      "start_run": { "seed": 102, "no_target": true },
      "steps": [
        { "cmd": "teleport", "to": "stairs_down" },
        { "cmd": "stairs_report", "expect": [ { "path": "last.stairs_report.flights.0.shape", "value": "switchback" } ] },
        { "cmd": "walk_flight", "dir": "down", "frames": 900 },
        { "expect": [ { "path": "run.level", "value": -1 } ] },
        { "cmd": "goto", "x": 51.5, "z": 76.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] },
        { "cmd": "goto", "x": 51.5, "z": 70.5, "max_frames": 900, "expect": [ { "path": "last.arrived", "value": true } ] }
      ]
    }
  ]
}
