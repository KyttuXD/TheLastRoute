# /etc/lr-story-server/lr-story-server.env on VPS 2 (root only, mode 0640, never committed). Names only; set real values on the server.
LR_STORY_HOST=0.0.0.0
LR_STORY_HTTP_PORT=8307
LR_STORY_RELAY_PORT=1307
LR_STORY_RELAY_ENABLED=true
LR_STORY_DATA_DIR=/var/lib/lr-story-server
LR_STORY_PACKS_DIR=/opt/lr-story-server/mods
# Caddy is in front of the HTTP API: trust its X-Forwarded-For for the rate limits.
LR_STORY_TRUST_PROXY=true
# The account website (same setting as lr_server). On VPS 2 the Last Route backend listens on loopback, so players sign
# in with their Last Route account. Plain http only. Leave unset to keep this server's own accounts.json.
LASTROUTE_ACCOUNT_UPSTREAM=http://127.0.0.1:8205
