#!/bin/sh
# Rejects pushes whose new commits name an AI as author or committer, or carry an AI attribution line (see AGENTS.md).
# Only author/committer fields and attribution lines are checked; ordinary words in messages (such as "cursor", the mouse pointer) are allowed.
Z=0000000000000000000000000000000000000000
bad=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z" ] && continue
  if [ "$remote_sha" = "$Z" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  if git log "$range" --format='%an <%ae>%n%cn <%ce>' | grep -i -E 'claude|anthropic|cursoragent|cursor@|copilot|openai|chatgpt|gemini' >/dev/null; then
    echo "push rejected: AI author or committer in $range (AGENTS.md)." >&2; bad=1
  fi
  if git log "$range" --format='%B' | grep -i -E '^(co-authored-by|generated with|signed-off-by).*(claude|anthropic|cursor|copilot|openai|gpt|gemini)|generated with .*claude|🤖' >/dev/null; then
    echo "push rejected: AI attribution line in $range (AGENTS.md)." >&2; bad=1
  fi
done
exit $bad
