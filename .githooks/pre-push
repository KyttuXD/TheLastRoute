#!/bin/sh
# Rejects pushes whose new commits carry AI attribution or AI author names (see AGENTS.md).
bad=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  if git log "$range" --format='%an %ae %cn %ce%n%B' | grep -i -E 'claude|anthropic|cursor@|cursoragent|copilot|openai|chatgpt|gemini|generated with|🤖|co-authored-by:.*(claude|cursor|anthropic)' >/dev/null; then
    echo "push rejected: AI name or attribution found in $range (AGENTS.md)." >&2
    bad=1
  fi
done
exit $bad
