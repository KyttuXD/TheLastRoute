#!/bin/sh
# Rejects any attribution line in commit messages (see AGENTS.md): no Co-Authored-By, no Generated-with, no Signed-off-by.
if grep -i -E '^(co-authored-by|generated with|signed-off-by)|generated with .*claude|🤖' "$1" >/dev/null; then
  echo "commit rejected: attribution line found (AGENTS.md forbids these)." >&2
  exit 1
fi
