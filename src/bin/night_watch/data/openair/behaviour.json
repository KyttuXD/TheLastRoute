    "sort_boxes": {"pose": "kneel", "speed": 1.0, "label": "sorts boxes"},
    "tap_terminal": {"pose": "reach_out", "speed": 2.4, "label": "taps a terminal"},
    "sit": {"pose": "sit", "speed": 1.0, "label": "sits down"},
    "pace": {"pose": null, "speed": 1.0, "pace": true, "label": "paces"}
  },
  "default": {
