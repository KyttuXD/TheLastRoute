    "task_s": [5.0, 10.0],
    "wait_s": [3.0, 8.0],
    "roam_hops": 0,
    "tasks": {"wipe_counter": 1.0, "check_locker": 1.0, "sort_boxes": 1.0, "tap_terminal": 1.0, "sit": 1.0, "pace": 1.0}
  },
  "hunters": {
    "verrine": {
      "weights": {"stare": 3.0, "task": 2.0, "wait": 3.0},
      "stare_s": [4.0, 8.0],
      "tasks": {"pace": 3.0, "check_locker": 2.0, "tap_terminal": 1.0, "sort_boxes": 1.0, "sit": 0.0, "wipe_counter": 0.0}
    },
    "wynelle": {
      "weights": {"stare": 3.0, "task": 0.0, "wait": 4.0},
      "stare_s": [3.0, 7.0],
      "wait_s": [4.0, 10.0]
    },
    "ysolde": {
      "weights": {"stare": 1.0, "task": 4.0, "wait": 3.0},
