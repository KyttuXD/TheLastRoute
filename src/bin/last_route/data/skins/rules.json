{
	"schema": "lr.skin_rules/1",
	"url": {
		"scheme": "https://",
		"max_length": 512,
		"timeout_secs": 5,
		"port": 443,
		"blocked_hosts": ["localhost"],
		"blocked_suffixes": [".localhost", ".local", ".internal", ".lan"]
	},
	"minecraft": {
		"name_max": 16,
		"name_chars": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_",
		"lookup_url": "https://api.mojang.com/users/profiles/minecraft/{name}",
		"lookup_host": "api.mojang.com",
		"profile_url": "https://sessionserver.mojang.com/session/minecraft/profile/{uuid}",
		"profile_host": "sessionserver.mojang.com",
		"textures_host": "textures.minecraft.net"
	},
	"layout": {
		"overlay_rects": [[32, 0, 32, 16], [16, 32, 24, 16], [40, 32, 16, 16], [0, 32, 16, 16], [48, 48, 16, 16], [0, 48, 16, 16]],
		"slim_probe_rects": [[50, 16, 2, 4], [54, 20, 2, 12], [42, 48, 2, 4], [46, 52, 2, 12]],
		"legacy_mirror": [{"from": [0, 16], "to": [16, 48]}, {"from": [40, 16], "to": [32, 48]}]
	}
}
