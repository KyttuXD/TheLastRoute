{
  "schema": "lr.hiding/1",
  "note": "Extra hiding kinds besides lockers. capacity = bodies per spot. Rules: the first matching rule wins per room (when both regions and room_types are listed both must match; one list alone matches on it; empty lists match anything). only_if_none rules are the fallback for rooms with no locker. prop_styles turns solid room props into hiding spots of a kind.",
  "kinds": {
    "wardrobe": { "capacity": 2, "label": "WARDROBE" },
    "closet": { "capacity": 1, "label": "CLOSET" },
    "stall": { "capacity": 1, "label": "STALL" },
    "underdesk": { "capacity": 1, "label": "UNDER DESK" },
    "cabinet": { "capacity": 1, "label": "CABINET" },
    "freezer": { "capacity": 2, "label": "FREEZER" },
    "planter": { "capacity": 1, "label": "PLANTER" },
    "bunk": { "capacity": 2, "label": "BUNK" }
  },
  "default_capacity": 1,
  "furniture_capacity": { "locker": 2, "wardrobe": 2, "bed": 2, "closet": 1 },
  "inspect": {
    "_note": "Locker inspection (Godot hunter_inspect.gd). A hunter passing a slatted spot with a runner inside who did NOT see them hide stops, turns, leans in and lingers while the runner's breath meter fills, then moves on. reveal_when_full: a full meter finds the runner (off in Standard: the hunter moves on without finding them). breath_fill_per_second fills during lean and linger; breath_drain_per_second empties it otherwise.",
    "reach": 3.0, "stand_out": 1.8, "stand_min": 1.6, "turn_seconds": 0.6, "lean_seconds": 1.6, "rise_seconds": 1.2,
    "walk_scale": 0.6, "walk_limit": 8.0, "spot_cooldown": 25.0, "leave_distance": 4.0,
    "walk_arrive": 0.05, "breath_fill_per_second": 0.27, "breath_drain_per_second": 0.8, "reveal_when_full": false,
    "default": { "chance": 0.3, "stand": 1.8, "linger_scale": 1.0 },
    "per_hunter": { "nyxie": { "chance": 0.12, "stand": 1.7, "linger_scale": 2.0 } },
    "excluded": ["wynelle", "void_gray", "ilyra", "zellia", "verrine", "ferryn", "javelle"],
    "difficulty": {
      "standard": { "chance": 1.0, "linger": 1.5, "cooldown": 40.0 },
      "hard": { "chance": 1.15, "linger": 2.0, "cooldown": 30.0 },
      "nightmare": { "chance": 1.3, "linger": 2.5, "cooldown": 22.0 }
    }
  },
  "hunter_anim": { "_note": "Seconds of each step of a hunter checking a locker: search tell, open, reach in, pull out. reach_height is how high the hand goes on the occupant (metres); pull_distance how far the occupant is dragged out.", "tell": 0.6, "open": 0.5, "reach_in": 0.6, "pull_out": 0.8, "reach_height": 1.1, "pull_distance": 1.2 },
  "default_spacing": 2.5,
  "rules": [
    { "kind": "wardrobe", "regions": ["apartment"], "room_types": ["bedroom"], "min": 1, "max": 2, "min_area": 12 },
    { "kind": "closet", "regions": ["apartment"], "room_types": [], "min": 1, "max": 1, "min_area": 12 },
    { "kind": "stall", "regions": ["stalls"], "room_types": [], "min": 1, "max": 3, "min_area": 6, "spacing": 1.5 },
    { "kind": "underdesk", "regions": ["offices"], "room_types": [], "min": 1, "max": 3, "min_area": 12 },
    { "kind": "cabinet", "regions": ["lab"], "room_types": [], "min": 1, "max": 2, "min_area": 12 },
    { "kind": "freezer", "regions": ["cold", "ice"], "room_types": [], "min": 1, "max": 2, "min_area": 12 },
    { "kind": "planter", "regions": ["greenhouse"], "room_types": [], "min": 1, "max": 3, "min_area": 12 },
    { "kind": "bunk", "regions": ["prison"], "room_types": [], "min": 1, "max": 3, "min_area": 12 },
    { "kind": "closet", "regions": [], "room_types": [], "min": 1, "max": 1, "min_area": 20, "only_if_none": true }
  ],
  "prop_styles": {
    "prisonBunk": "bunk",
    "bunkBed": "bunk",
    "raisedPlanter": "planter",
    "mallPlanter": "planter"
  }
}
