{
  "schema": "lr.hud_bars/1",
  "_note": "The status grid above the hotbar (ui/hud_bars.rs). `columns` 3 lays the six bars as two rows of three: BATTERY, STAMINA, FADE / EXPOSURE, NOISE, TEMP. No icons and no panel. Captions use the short label (`BAT 97% // F`). `colour` is the bar's fill. `source` is the meter: lamp, stamina, fade (crouch amount), exposure, noise, temperature. `zones` name the readout. `overrides` replace the zone while their `when` holds. TEMP thresholds: 10 freezing, 60 Wynelle cold, 76 heat haze, 90 overheating, 100 heat latch. Design: KT 2026-11-06.",
  "layout": {
    "max_width": 168.0,
    "gap": 3.0,
    "icon": 6.0,
    "bar_height": 3.0,
    "bar_min": 24.0,
    "text_size": 4.5,
    "sub_size": 4.0,
    "pad": 1.0,
    "columns": 3
  },
  "bars": [
    {
      "id": "lamp",
      "shown": false,
      "source": "lamp",
      "label": "BATTERY",
      "short": "BAT",
      "glyph": "bulb",
      "colour": "#ffc857",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "DEAD", "colour": "#e64451", "alert": true },
        { "from": 1.0, "name": "LOW", "colour": "#e64451", "alert": true },
        { "from": 22.0, "name": "F", "colour": "#ffc857", "alert": false }
      ],
      "ticks": [
        { "at": 22.0, "label": "22" }
      ],
      "overrides": [
        { "when": "safe_zone", "name": "CHARGE", "colour": "#75c492", "alert": false }
      ]
    },
    {
      "id": "stamina",
      "source": "stamina",
      "label": "STAMINA",
      "short": "STA",
      "glyph": "runner",
      "colour": "#6fe8ff",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "LOW", "colour": "#ff4d5e", "alert": true },
        { "from": 20.0, "name": "TIRED", "colour": "#ffc857", "alert": false },
        { "from": 45.0, "name": "FIT", "colour": "#6fe8ff", "alert": false }
      ],
      "ticks": [
        { "at": 20.0, "label": "20" },
        { "at": 45.0, "label": "45" }
      ],
      "overrides": [
        { "when": "exhausted", "name": "SPENT", "colour": "#e64451", "alert": true },
        { "when": "stim", "name": "STIM", "colour": "#75c492", "alert": false }
      ]
    },
    {
      "id": "fade",
      "source": "fade",
      "label": "FADE",
      "short": "FAD",
      "glyph": "veil",
      "colour": "#d7dde8",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "SOLID", "colour": "#d7dde8", "alert": false },
        { "from": 50.0, "name": "FADED", "colour": "#f2f5fa", "alert": false }
      ],
      "ticks": [],
      "overrides": []
    },
    {
      "id": "exposure",
      "shown": false,
      "source": "exposure",
      "label": "EXPOSURE",
      "short": "EXP",
      "glyph": "eye",
      "colour": "#ff6a3d",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "LOW", "colour": "#75c492", "alert": false },
        { "from": 20.0, "name": "LIT", "colour": "#ff6a3d", "alert": false },
        { "from": 75.0, "name": "EXPOSED", "colour": "#ff3b2f", "alert": true }
      ],
      "ticks": [
        { "at": 20.0, "label": "20" },
        { "at": 75.0, "label": "75" }
      ],
      "overrides": []
    },
    {
      "id": "noise",
      "shown": false,
      "source": "noise",
      "label": "NOISE",
      "short": "NSE",
      "glyph": "sound",
      "colour": "#3de0e8",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "QUIET", "colour": "#3de0e8", "alert": false },
        { "from": 40.0, "name": "LOUD", "colour": "#ffc857", "alert": false },
        { "from": 75.0, "name": "ALARM", "colour": "#ff3b2f", "alert": true }
      ],
      "ticks": [
        { "at": 40.0, "label": "40" },
        { "at": 75.0, "label": "75" }
      ],
      "overrides": []
    },
    {
      "id": "temperature",
      "source": "temperature",
      "label": "TEMP",
      "short": "TMP",
      "glyph": "thermometer",
      "colour": "#ff5a2f",
      "min": 0.0,
      "max": 100.0,
      "unit": "",
      "tick_numbers": true,
      "zones": [
        { "from": 0.0, "name": "FROZEN", "colour": "#4d9cff", "alert": true },
        { "from": 10.01, "name": "COLD", "colour": "#6ec8ff", "alert": false },
        { "from": 60.0, "name": "STABLE", "colour": "#75c492", "alert": false },
        { "from": 76.0, "name": "WARM", "colour": "#ffc857", "alert": false },
        { "from": 90.0, "name": "HOT", "colour": "#ff5a2f", "alert": true },
        { "from": 100.0, "name": "LATCH", "colour": "#ff2a44", "alert": true }
      ],
      "ticks": [
        { "at": 10.0, "label": "10" },
        { "at": 60.0, "label": "60" },
        { "at": 90.0, "label": "90" }
      ],
      "overrides": [
        { "when": "heat_locked", "name": "LATCHED", "colour": "#ff2a44", "alert": true }
      ]
    }
  ]
}
