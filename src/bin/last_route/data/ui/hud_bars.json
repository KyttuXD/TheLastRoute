{
  "schema": "lr.hud_bars/1",
  "_note": "The status row above the hotbar (ui/hud_bars.rs). One thin outlined bar per entry, left to right: BATTERY, STAMINA, FADE, EXPOSURE, NOISE, TEMP. No icons and no panel. `colour` is the bar's fill; the zone still names the readout (`BATTERY 97% // F`). `source` is the meter: lamp = flashlight charge in percent, stamina = sprint stamina in percent, fade = how far the body has crouched (0 standing, 100 fully ducked), exposure = how visible the runner is, noise = the noise meter, temperature = body temperature 0..100. `zones` name the readout by value. `overrides` are checked first, in order, and replace the zone's name and colour while their `when` holds. The TEMP thresholds are the real game thresholds: 10 freezing, 60 (Wynelle's cold), 76 (heat haze), 90 overheating, 100 the heat latch. Design: KT 2026-11-06.",
  "layout": {
    "max_width": 138.0,
    "gap": 2.0,
    "icon": 6.0,
    "bar_height": 3.0,
    "bar_min": 24.0,
    "text_size": 5.5,
    "sub_size": 5.0,
    "pad": 2.0
  },
  "bars": [
    {
      "id": "lamp",
      "source": "lamp",
      "label": "BATTERY",
      "short": "BAT",
      "glyph": "bulb",
      "colour": "#f2bb62",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "DEAD", "colour": "#e64451", "alert": true },
        { "from": 1.0, "name": "LOW", "colour": "#e64451", "alert": true },
        { "from": 22.0, "name": "F", "colour": "#f2bb62", "alert": false }
      ],
      "ticks": [
        { "at": 22.0, "label": "22" }
      ],
      "overrides": [
        { "when": "safe_zone", "name": "CHARGE", "colour": "#75c492", "alert": false }
      ]
    },
    {
      "id": "stamina",
      "source": "stamina",
      "label": "STAMINA",
      "short": "STA",
      "glyph": "runner",
      "colour": "#8fd0e0",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "LOW", "colour": "#e64451", "alert": true },
        { "from": 20.0, "name": "TIRED", "colour": "#f2bb62", "alert": false },
        { "from": 45.0, "name": "FIT", "colour": "#8fd0e0", "alert": false }
      ],
      "ticks": [
        { "at": 20.0, "label": "20" },
        { "at": 45.0, "label": "45" }
      ],
      "overrides": [
        { "when": "exhausted", "name": "SPENT", "colour": "#e64451", "alert": true },
        { "when": "stim", "name": "STIM", "colour": "#75c492", "alert": false }
      ]
    },
    {
      "id": "fade",
      "source": "fade",
      "label": "FADE",
      "short": "FAD",
      "glyph": "veil",
      "colour": "#9aa0a8",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "SOLID", "colour": "#9aa0a8", "alert": false },
        { "from": 50.0, "name": "FADED", "colour": "#c8ccd0", "alert": false }
      ],
      "ticks": [],
      "overrides": []
    },
    {
      "id": "exposure",
      "source": "exposure",
      "label": "EXPOSURE",
      "short": "EXP",
      "glyph": "eye",
      "colour": "#e07a4f",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "LOW", "colour": "#75c492", "alert": false },
        { "from": 20.0, "name": "LIT", "colour": "#e07a4f", "alert": false },
        { "from": 75.0, "name": "EXPOSED", "colour": "#ff5a45", "alert": true }
      ],
      "ticks": [
        { "at": 20.0, "label": "20" },
        { "at": 75.0, "label": "75" }
      ],
      "overrides": []
    },
    {
      "id": "noise",
      "source": "noise",
      "label": "NOISE",
      "short": "NSE",
      "glyph": "sound",
      "colour": "#4fb6c7",
      "min": 0.0,
      "max": 100.0,
      "unit": "%",
      "zones": [
        { "from": 0.0, "name": "QUIET", "colour": "#4fb6c7", "alert": false },
        { "from": 40.0, "name": "LOUD", "colour": "#f2bb62", "alert": false },
        { "from": 75.0, "name": "ALARM", "colour": "#ff5a45", "alert": true }
      ],
      "ticks": [
        { "at": 40.0, "label": "40" },
        { "at": 75.0, "label": "75" }
      ],
      "overrides": []
    },
    {
      "id": "temperature",
      "source": "temperature",
      "label": "TEMP",
      "short": "TMP",
      "glyph": "thermometer",
      "colour": "#e0512f",
      "min": 0.0,
      "max": 100.0,
      "unit": "",
      "tick_numbers": true,
      "zones": [
        { "from": 0.0, "name": "FROZEN", "colour": "#3d7ee0", "alert": true },
        { "from": 10.01, "name": "COLD", "colour": "#5aa9e0", "alert": false },
        { "from": 60.0, "name": "STABLE", "colour": "#75c492", "alert": false },
        { "from": 76.0, "name": "WARM", "colour": "#f2bb62", "alert": false },
        { "from": 90.0, "name": "HOT", "colour": "#e0512f", "alert": true },
        { "from": 100.0, "name": "LATCH", "colour": "#ff2a44", "alert": true }
      ],
      "ticks": [
        { "at": 10.0, "label": "10" },
        { "at": 60.0, "label": "60" },
        { "at": 90.0, "label": "90" }
      ],
      "overrides": [
        { "when": "heat_locked", "name": "LATCHED", "colour": "#ff2a44", "alert": true }
      ]
    }
  ]
}
