# Last Route backend configuration
# Copy this file to /home/container/backend/.env on Pterodactyl.
# Paths are resolved from /home/container, where `node index.js` starts.

# HTTP room directory, account API, web build, and update downloads (TCP)
HOST=0.0.0.0
LASTROUTE_HTTP_PORT=8105
# Optional Pterodactyl fallbacks. LASTROUTE_HTTP_PORT takes precedence.
PORT=8105
SERVER_PORT=8105

# Authenticated ENet gameplay relay (UDP)
LASTROUTE_RELAY_ENABLED=true
LASTROUTE_RELAY_HOST=lastroute.kyttuslab.org
LASTROUTE_RELAY_PORT=1105
ENET_ROOM_TTL_SECONDS=60

# Persistent accounts and optional hosted content
LASTROUTE_DATA_DIR=./.data
LASTROUTE_ACCOUNT_STORE=./.data/accounts.json
LASTROUTE_PUBLIC_DIR=./web
LASTROUTE_CUSTOM_MAP_DIR=./art/custom-maps

# Reserved KYTTU/AYTTU owner-account setup key. Set this privately and never commit it.
LASTROUTE_ADMIN_PASSWORD=

# Stable GitHub Release mirroring for the in-game updater
LASTROUTE_AUTO_UPDATE=true
LASTROUTE_GITHUB_REPO=KyttuXD/LastRouteGodot
LASTROUTE_GITHUB_TAG=debug
LASTROUTE_GITHUB_TOKEN=
LASTROUTE_UPDATE_POLL_SECONDS=15
LASTROUTE_UPDATE_DIR=./updates
LASTROUTE_UPDATE_MANIFEST=./updates/updates.debug.json

# Restart request when the deployed main branch falls behind GitHub
LASTROUTE_RESTART_ON_GITHUB_UPDATE=true
LASTROUTE_GITHUB_BRANCH=main
LASTROUTE_SOURCE_POLL_SECONDS=30
# Set this only when the deployment has no .git directory.
LASTROUTE_DEPLOYED_REVISION=

# Request limits and reverse-proxy trust
LASTROUTE_RATE_LIMIT_WINDOW_SECONDS=60
LASTROUTE_API_RATE_LIMIT=600
LASTROUTE_ACCOUNT_RATE_LIMIT=30
TRUST_PROXY=false

# Supported compatibility aliases (normally leave unset):
# GITHUB_TOKEN=
# GH_TOKEN=
# ACCESS_TOKEN=
# KYTTU_DEV_PASSWORD=
# KYTTU_DATA_DIR=
# KYTTU_ACCOUNT_STORE_PATH=

# Build/export-only options; the running backend does not need these.
# LASTROUTE_BUILD_REVISION=
# LASTROUTE_ALLOW_DIRTY_BUILD=false

# Mod pack index (metadata only; pack files are served from VPS 2)
# LASTROUTE_MOD_INDEX_STORE=
# LASTROUTE_MOD_DOWNLOAD_BASE=https://<vps2-host>/lr3d/mods
# LASTROUTE_MOD_RATE_LIMIT=120
